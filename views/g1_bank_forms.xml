<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ================= CUENTA · FORM ================= -->
        <record id="g1_account_form" model="ir.ui.view">
            <field name="name">g1.account.form</field>
            <field name="model">g1.account</field>
            <field name="arch" type="xml">
                <form string="Cuenta">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="account_type"/>
                            </group>
                            <group>
                                <field name="begin_balance"/>
                                <field name="credit_line"/>
                                <field name="balance"/>
                                <field name="opening_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Movimientos">
                                <field name="movement_ids" readonly="1">
                                    <tree>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="amount"/>
                                        <field name="balance"/>
                                        <field name="timestamp"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================= MOVIMIENTO · FORM ================= -->
        <record id="g1_movement_form" model="ir.ui.view">
            <field name="name">g1.movement.form</field>
            <field name="model">g1.movement</field>
            <field name="arch" type="xml">
                <form string="Movimiento">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="account_id"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="amount"/>
                                <field name="balance"/>
                                <field name="timestamp"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
