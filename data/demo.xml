<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================= CUENTAS ================= -->
        <record id="demo_account_1" model="g1.account">
            <field name="name">ES21 1000 2030 4000 0001</field>
            <field name="description">Cuenta Nómina</field>
            <field name="account_type">standard</field>
            <field name="begin_balance">1000.0</field>
        </record>

        <record id="demo_account_2" model="g1.account">
            <field name="name">ES21 1000 2030 4000 0002</field>
            <field name="description">Cuenta Crédito</field>
            <field name="account_type">credit</field>
            <field name="begin_balance">200.0</field>
            <field name="credit_line">500.0</field>
        </record>

        <record id="demo_account_3" model="g1.account">
            <field name="name">ES21 1000 2030 4000 0003</field>
            <field name="description">Cuenta Ahorro</field>
            <field name="account_type">standard</field>
            <field name="begin_balance">5000.0</field>
        </record>

        <!-- ================= MOVIMIENTOS ================= -->
        <record id="demo_movement_1" model="g1.movement">
            <field name="name">MOV-001</field>
            <field name="description">deposit</field>
            <field name="amount">300.0</field>
            <field name="account_id" ref="demo_account_1"/>
        </record>

        <record id="demo_movement_2" model="g1.movement">
            <field name="name">MOV-002</field>
            <field name="description">payment</field>
            <field name="amount">150.0</field>
            <field name="account_id" ref="demo_account_1"/>
        </record>

        <record id="demo_movement_3" model="g1.movement">
            <field name="name">MOV-003</field>
            <field name="description">deposit</field>
            <field name="amount">1200.0</field>
            <field name="account_id" ref="demo_account_3"/>
        </record>

    </data>
</odoo>
